	(text "TPS259531DSGR\nOUTPUT VOLTAGE CLAMP: 5.7 V (typ)\nUNDERVOLTAGE LOCKOUT: Vsupply = VUVLO * (R1 + R2) / R2\nACTIVE CURRENT LIMITING: RILM = 2000/(ILIMIT - 0.04), for 4A RILM = 495Ohms"
		(exclude_from_sim no)
		(at 57.658 139.446 0)
		(effects
