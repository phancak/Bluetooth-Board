	(text "PIN1 NC = Oscillation"
		(exclude_from_sim no)
		(at 225.806 86.868 0)
		(effects
			(font
				(size 1 1)
				(thickness 0.125)
			)
			(justify right)
		)
		(uuid "1271531d-74bc-4f64-8f9d-4526387b5d05")
	)
	(text "The load capacitances are integrated on chip and \ncan be tuned according to the selected crystal via \nan internal register. By default, the load capacitances \nare 8 pF for the NX2016 from NDK used on the boards.\n\nRCC clock HSE register (RCC_HSECR)\nBits 13:8 HSETUNE[5:0]: HSE capacitor tuning\nCan be changed by software. Do not change when HSE is on.\n0x00: minimum load capacitance\n0x3F maximum load capacitance"
		(exclude_from_sim no)
		(at 38.354 150.622 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "17cb0fff-ad40-4fcc-a6ba-f33e4d883323")
	)
	(text "Can be used as GPIO"
		(exclude_from_sim no)
		(at 145.542 82.804 0)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "191491d9-afe1-4595-b6c8-5dabeb3fb6eb")
	)
	(text "NRST has internal pull-up \nresistor\n-When button not pushed NRST \nis HIGH\n-Pushing the button causes \ncurrent\nto flow and pulls NRST low"
		(exclude_from_sim no)
		(at 167.386 122.682 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left)
		)
		(uuid "3188c40f-b960-437f-b9f0-bd9d49d73d71")
	)
	(text "BOOT0 Switch HIGH enables \nUART or I2C to allow\nprogramminng of the MCU"
		(exclude_from_sim no)
		(at 211.328 107.188 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "48f03a45-b548-48a1-9702-f45ddac55dd6")
	)
	(text "Load Capacitors are inside the MCU\nSet RCC_HSECR register"
		(exclude_from_sim no)
		(at 54.864 120.65 0)
		(effects
			(font
				(size 1 1)
			)
		)
		(uuid "5ad75dba-2b0d-4e29-be91-d42ea2e5f1c1")
	)
	(text "The external capacitor \non NRST must be placed \nas close as possible to \nthe device."
		(exclude_from_sim no)
